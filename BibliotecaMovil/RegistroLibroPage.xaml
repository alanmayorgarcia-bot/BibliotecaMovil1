<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BibliotecaMovil.RegistroLibroPage"
             Title="Nuevo Registro"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Center">

            <Border Style="{StaticResource CardStyle}" Padding="22">
                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Alta de Libro" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Guarda el registro en el motor SQLite local" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>

                    <!-- Actividad 3: Formulario estructurado con Grid -->
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="14" ColumnSpacing="12">

                        <Label Text="Título:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" FontAttributes="Bold" TextColor="#334155"/>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBorderStyle}">
                            <Entry x:Name="TxtTitulo" Placeholder="Ej. C# 12 y .NET 8" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"/>
                        </Border>

                        <Label Text="Autor:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" FontAttributes="Bold" TextColor="#334155"/>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBorderStyle}">
                            <Entry x:Name="TxtAutor" Placeholder="Ej. Mark J. Price" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"/>
                        </Border>

                        <Label Text="Categoría:" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" FontAttributes="Bold" TextColor="#334155"/>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBorderStyle}">
                            <Entry x:Name="TxtCategoria" Placeholder="Ej. Programación, Redes" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"/>
                        </Border>
                    </Grid>

                    <Button Text="Guardar Registro en SQLite" 
                            Style="{StaticResource BtnPrincipal}" 
                            Margin="0,8,0,0"
                            Clicked="OnGuardarClicked"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>