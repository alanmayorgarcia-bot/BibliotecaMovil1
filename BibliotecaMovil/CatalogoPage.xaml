<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BibliotecaMovil.CatalogoPage"
             Title="Catálogo General"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="18" MaximumWidthRequest="720" HorizontalOptions="Center">

            <!-- Encabezado con Grid (Actividad 3) -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Catálogo de Libros" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Persistencia activa con SQLite (.NET MAUI)" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>

                    <!-- Actividad 2: HorizontalStackLayout para Botones de Acción Global -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="+ Registrar" Style="{StaticResource BtnSecundario}" Clicked="OnNuevoLibroClicked"/>
                        <Button Text="Refrescar" BackgroundColor="#6366F1" TextColor="White" CornerRadius="10" FontAttributes="Bold" HeightRequest="38" FontSize="13" Clicked="OnRefrescarClicked"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Actividad 4: FlexLayout para Filtros por Categoría (Badges) -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Categorías Disponibles:" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                <FlexLayout Direction="Row" Wrap="Wrap">
                    <Border BackgroundColor="{StaticResource PrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,6" Margin="3">
                        <Label Text="Todos" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                    <Border BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,6" Margin="3">
                        <Label Text="Programación" TextColor="#3730A3" FontSize="12"/>
                    </Border>
                    <Border BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,6" Margin="3">
                        <Label Text="Bases de Datos" TextColor="#3730A3" FontSize="12"/>
                    </Border>
                    <Border BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,6" Margin="3">
                        <Label Text="Redes" TextColor="#3730A3" FontSize="12"/>
                    </Border>
                    <Border BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,6" Margin="3">
                        <Label Text="Inteligencia Artificial" TextColor="#3730A3" FontSize="12"/>
                    </Border>
                </FlexLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>

            <!-- Actividades 6 y 3: BindableLayout + Grid para renderizar tarjetas de SQLite -->
            <VerticalStackLayout x:Name="ContenedorLibros" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">

                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Titulo}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Autor, StringFormat='Autor: {0}'}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>

                                <Border Grid.Row="2" Grid.Column="0" HorizontalOptions="Start" BackgroundColor="#EEF2FF" Stroke="#C7D2FE" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,3">
                                    <Label Text="{Binding Categoria}" FontSize="11" TextColor="#4338CA" FontAttributes="Bold"/>
                                </Border>

                                <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="Eliminar" BackgroundColor="{StaticResource DangerColor}" TextColor="White" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="36" Padding="12,0" Clicked="OnEliminarLibroClicked" CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>